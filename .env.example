# ---------------------------------------------------------------------------
# Copier en .env puis remplir.  Le .env ne doit JAMAIS être versionné.
# ---------------------------------------------------------------------------

# --- PostgreSQL : base interne de n8n (workflows, credentials)
POSTGRES_DB=n8n
POSTGRES_USER=n8n
# openssl rand -hex 16
POSTGRES_PASSWORD=

# --- PostgreSQL : base métier (articles de veille)
VEILLE_DB=veille
VEILLE_USER=veille
# openssl rand -hex 16
VEILLE_PASSWORD=

# --- n8n
# Chiffre les credentials en base. À générer UNE fois et à conserver :
# la perdre rend les credentials stockés illisibles.
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# --- Secrets du workflow de veille
# Discord : Paramètres du salon > Intégrations > Créer un webhook
DISCORD_WEBHOOK_URL=
