# ---------------------------------------------------------------------------
# Copy to .env and fill in.  .env must NEVER be committed.
# ---------------------------------------------------------------------------

# --- PostgreSQL: n8n internal database (workflows, credentials)
POSTGRES_DB=n8n
POSTGRES_USER=n8n
# openssl rand -hex 16
POSTGRES_PASSWORD=

# --- PostgreSQL: business database (monitoring articles)
VEILLE_DB=veille
VEILLE_USER=veille
# openssl rand -hex 16
VEILLE_PASSWORD=

# --- n8n
# Encrypts the credentials stored in the database. Generate it ONCE and keep
# it: losing it makes the stored credentials unreadable.
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# --- Monitoring workflow secrets
# Discord: Channel settings > Integrations > Create Webhook
DISCORD_WEBHOOK_URL=
